# Dependencies
node_modules/

# Playwright output
/test-results/
/playwright-report/
/blob-report/
/blob-report-*/
/all-blob-reports/
/ortoni-report/
/playwright/.cache/
/playwright/.auth/
/.auth/

# Build + runtime artifacts
/dist/
/logs/
/downloads/

# Environment configuration
# Every env file lives in envs/ — see ENVIRONMENT_CONSTANTS.ROOT in
# src/config/environment/constants/environment.const.ts. A real .env holds live
# credentials and is never committed. The one exception is the template,
# envs/.env.example: key names with placeholder values, checked in so the next
# engineer knows which variables exist.
#
# The negation is pinned to that exact path on purpose. An unanchored
# `!.env.example` would also un-ignore a copy at the repository root — a second
# template, in a directory nothing loads, free to drift out of step with the real
# one. The pre-commit guard rejects that path for the same reason.
.env*
!envs/.env.example
