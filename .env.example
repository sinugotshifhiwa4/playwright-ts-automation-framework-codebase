# Template for .env — copy to .env and fill in real values.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials; the pre-commit guard
# rejects any file matching .env and scans staged content for credential shapes.
# Add every new key here, with a placeholder, so the next engineer knows it exists.

# Which environment the suite runs against: dev | qa | prod
TEST_ENV=dev

# Base URL of the application under test. Overrides the per-environment default.
BASE_URL=https://example.com

# Credentials for the standard test account.
TEST_USERNAME=replace-me
TEST_PASSWORD=replace-me
