{
  // The single source of truth for Markdown linting: which files, and which rules.
  //
  // `ignores` lives here rather than in the npm script because lint-staged hands
  // markdownlint an explicit list of staged paths, and CLI ignore globs do not
  // apply to an explicit list. With the exclusions written as CLI arguments, the
  // two callers disagreed: `npm run lint:md` skipped .claude/ while the commit
  // hook linted it, so validate passed and the commit was rejected. Config is read
  // by both callers, so there is one answer.
  //
  // `globs` is deliberately NOT set here. The two callers have different scopes —
  // npm run lint:md sweeps the repo, lint-staged passes only the staged files —
  // and a `globs` entry is merged with, not overridden by, a caller's arguments.
  // Setting it would make lint-staged --fix rewrite files it never staged, which
  // it then would not re-stage: silent edits left in the working tree.
  // Every pattern carries a leading `**/` so it matches whether the path arrives
  // relative — `npm run lint:md` sweeping the repo — or absolute, which is how
  // lint-staged hands over a staged file (`C:/…/.claude/skills/refactor/SKILL.md`).
  // A bare `.claude` matches only the first form, and the gap is invisible until a
  // commit is rejected by a check that `npm run validate` had just passed.
  "ignores": [
    "**/node_modules/**",

    // Not documentation. An executable skill is a prompt addressed to a model, and
    // CLAUDE.md is a manifest of @import lines — neither has a title, a table of
    // contents, or any of the structure these rules check for. Linting them
    // demands an H1 on a file whose first line is deliberately an instruction.
    "**/.claude/**",
    "**/CLAUDE.md"
  ],

  "config": {
    // Anchors in the table of contents are generated by the renderer, not by us.
    "MD051": false,

    // Line length. Prose is wrapped by hand at ~80; tables and URLs are not, and
    // splitting them would make them unreadable.
    "MD013": false
  }
}
