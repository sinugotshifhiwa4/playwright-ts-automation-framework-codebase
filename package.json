{
  "name": "playwright-ts-automation-framework-codebase",
  "version": "1.0.0",
  "description": "End-to-end test automation framework built with Playwright and TypeScript, featuring reusable page objects, shared fixtures, multi-browser execution, and environment-based configuration (dev/qa/prod) for consistent runs locally and in CI.",
  "scripts": {
    "prepare": "husky || true",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run lint:md && npm run verify:rules && npm run verify:docs",
    "fix": "npm run lint:fix && npm run format",
    "quality": "npm run validate",
    "quality:fix": "npm run fix",
    "ci": "npm run validate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify:names": "node scripts/quality/validate-filenames.mjs --all",
    "verify:guards": "node scripts/quality/guard-staged.mjs --all",
    "verify:rules": "node scripts/quality/validate-always-apply.mjs --all",
    "verify:docs": "node scripts/quality/validate-doc-index.mjs --all",
    "verify:msg": "node scripts/quality/validate-commit-msg.mjs",
    "test:failed": "npx playwright test --last-failed",
    "ui": "cross-env TEST_LAYER=ui tsx scripts/execution/test-executor.ts --ui",
    "codegen": "npx playwright codegen",
    "debug": "cross-env TEST_LAYER=ui tsx scripts/execution/test-executor.ts --debug",
    "report": "npx playwright show-report --host 127.0.0.1 --port 0",
    "ortoni-report": "tsx scripts/reports/show-ortoni-report.ts",
    "ortoni-report:stop": "tsx scripts/reports/stop-ortoni-report.ts",
    "pretest:ui": "npm run lint:check",
    "pretest:api": "npm run lint:check",
    "pretest:db": "npm run lint:check",
    "test:ui": "cross-env TEST_LAYER=ui tsx scripts/execution/test-executor.ts",
    "test:api": "cross-env TEST_LAYER=api tsx scripts/execution/test-executor.ts",
    "test:db": "cross-env TEST_LAYER=db tsx scripts/execution/test-executor.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinugotshifhiwa4/playwright-ts-automation-framework-codebase.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "ui-testing",
    "page-object-model",
    "fixtures",
    "cross-environment",
    "multi-browser",
    "test-tags",
    "sharding",
    "winston",
    "eslint",
    "prettier",
    "husky",
    "lint-staged"
  ],
  "author": "Tshifhiwa Sinugo",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/sinugotshifhiwa4/playwright-ts-automation-framework-codebase/issues"
  },
  "homepage": "https://github.com/sinugotshifhiwa4/playwright-ts-automation-framework-codebase#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "luxon": "^3.7.2",
    "markdownlint-cli2": "^0.23.0",
    "ortoni-report": "^4.10.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "winston": "^3.19.0"
  }
}
